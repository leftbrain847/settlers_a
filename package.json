{
  "name": "settlers",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.ts\" \"tests/host/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc -p host/tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "e2e": "node tests/e2e/e2e.ts",
    "host:dev": "npm run build:host && cd host && wrangler dev --local",
    "host:deploy": "npm run build:host && cd host && wrangler deploy",
    "build:host": "node scripts/build-host.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@napi-rs/canvas": "1.0.13",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "@types/three": "0.162.0",
    "esbuild": "^0.28.2",
    "gl": "8.1.6",
    "jsdom": "^29.1.1",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "three": "0.162.0"
  }
}
